{
    "name": "open-dxp/test-foundation",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "description": "Everything a bundle or a project needs to have tests against OpenDXP.",
    "require": {
        "php": "~8.4.1 || ~8.5.0 || ~8.6.0",
        "dama/doctrine-test-bundle": "^8.6",
        "mtdowling/jmespath.php": "^2.8",
        "open-dxp/opendxp": "^1.5",
        "pestphp/pest": "^4.7 || ^5.0",
        "playwright-php/playwright": "^1.5",
        "playwright-php/playwright-symfony": "^0.11",
        "spatie/fork": "^1.2.8",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/process": "^8.1",
        "symfony/runtime": "^8.1",
        "zenstruck/browser": "^1.12",
        "zenstruck/foundry": "^2.13"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.54",
        "phpstan/phpstan-symfony": "^2.0.15"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\TestFoundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\TestFoundation\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/opendxp-test"
    ],
    "extra": {
        "app-template": "app",
        "branch-alias": {
            "dev-1.x": "1.2.x-dev"
        },
        "ai-mate": {
            "skills": ["skills"]
        }
    },
    "minimum-stability": "stable"
}
